# The Notary's test sandbox: Python + pytest only, run with --network none and a read-only root.
# The repository under test is mounted read-only at /src; results go to /out/result.json.
FROM docker.io/library/python:3.12-slim@sha256:1148dbb014615300fa7e713b2f94f550c0d1c69780c0805f84f093ceee34dd0b
RUN pip install --no-cache-dir pytest==9.2.0
COPY notary-run.py /usr/local/bin/notary-run
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /src
ENTRYPOINT ["python3", "/usr/local/bin/notary-run"]
